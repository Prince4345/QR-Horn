# Copy to .env.android (do not commit secrets) before `npm run android:build`
# Use your live Render / custom domain — NOT localhost (phones can't reach it).

VITE_APP_URL="https://YOUR_APP.onrender.com"
VITE_API_URL="https://YOUR_APP.onrender.com"
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional: load live site in WebView instead of bundling dist/
# CAPACITOR_SERVER_URL="https://YOUR_APP.onrender.com"
