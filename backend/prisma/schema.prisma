generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Owner {
  id         String            @id @default(uuid())
  authUserId String?           @unique
  name       String
  email      String            @unique
  phone      String?
  fcmToken   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  vehicles   Vehicle[]
  pushTokens OwnerPushToken[]
}

model OwnerPushToken {
  id        String   @id @default(uuid())
  ownerId   String
  token     String   @unique
  device    String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Vehicle {
  id               String                @id @default(uuid())
  ownerId          String
  name             String
  number           String
  numberNormalized String                @unique @default("")
  type             VehicleType
  active           Boolean               @default(true)
  theftMode        Boolean               @default(false)
  verified         Boolean               @default(false)
  verifiedAt       DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodGroup            String?
  allergies             String?
  medicalInfo           String?            @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  owner            Owner                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sticker          Sticker?
  notifications    Notification[]
  calls            Call[]
  activities       Activity[]
  chatSessions     ChatSession[]
  blockedScanners  ChatBlockedScanner[]
  verification     VehicleVerification?
  documents        VehicleDocument[]

  @@index([ownerId])
}

model VehicleDocument {
  id        String            @id @default(uuid())
  vehicleId String
  type      VaultDocumentType
  photoSlot String            @default("")
  fileName  String
  mimeType  String
  fileData  String            @db.Text
  expiresAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  vehicle   Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, type, photoSlot])
  @@index([vehicleId])
  @@index([expiresAt])
}

enum VaultDocumentType {
  RC
  INSURANCE
  PUC
  DRIVING_LICENSE
  VEHICLE_PHOTO
}

model VehicleVerification {
  id              String             @id @default(uuid())
  ownerId         String
  rcFingerprint   String             @unique
  plateNormalized String
  plateDisplay    String
  ownerNameOnRc   String
  ownerNameScore  Float
  confidence      Float
  suggestedName   String?
  suggestedType   VehicleType?
  status          VerificationStatus @default(READY)
  expiresAt       DateTime
  vehicleId       String?            @unique
  createdAt       DateTime           @default(now())
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([expiresAt])
}

enum VerificationStatus {
  RC_VERIFIED
  READY
  CONSUMED
  EXPIRED
}

model Sticker {
  id              String   @id @default(uuid())
  vehicleId       String   @unique
  code            String   @unique
  themeId         String   @default("default")
  customImageData String?
  /// JSON: imageMode, headline, tagline, socials, colors, overlay, showUrl
  customization   String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([code])
}

model Notification {
  id        String           @id @default(uuid())
  vehicleId String
  reason    ContactReason
  status    NotificationStatus @default(SENT)
  createdAt DateTime         @default(now())
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Call {
  id        String     @id @default(uuid())
  vehicleId String
  status    CallStatus @default(CONNECTING)
  createdAt DateTime   @default(now())
  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model Activity {
  id          String       @id @default(uuid())
  vehicleId   String
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

enum VehicleType {
  car
  bike
}

enum ContactReason {
  move
  lights
  parking
  emergency
  other
}

enum NotificationStatus {
  SENT
  READ
}

enum CallStatus {
  CONNECTING
  CONNECTED
  COMPLETED
  FAILED
}

enum ActivityType {
  notification
  call
  chat
}

model ChatSession {
  id            String            @id @default(cuid())
  vehicleId     String
  ownerId       String
  scannerToken  String
  /// Display name when the scanner is a registered ParksTAG user; null = Anonymous
  scannerName   String?
  callRoomId    String?
  reason        ContactReason?
  status        ChatSessionStatus @default(ACTIVE)
  activeUntil   DateTime
  readOnlyUntil DateTime?
  closedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@index([vehicleId])
  @@index([ownerId])
  @@index([scannerToken])
  @@index([callRoomId])
  @@index([status])
}

model ChatMessage {
  id           String         @id @default(cuid())
  sessionId    String
  senderRole   ChatSenderRole
  body         String
  isQuickReply Boolean        @default(false)
  readAt       DateTime?
  createdAt    DateTime       @default(now())
  session      ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatBlockedScanner {
  id           String   @id @default(uuid())
  vehicleId    String
  scannerToken String
  createdAt    DateTime @default(now())
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, scannerToken])
  @@index([vehicleId])
}

enum ChatSessionStatus {
  ACTIVE
  READ_ONLY
  CLOSED
  BLOCKED
}

enum ChatSenderRole {
  SCANNER
  OWNER
}
