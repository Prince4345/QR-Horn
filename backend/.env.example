# Supabase (same project as database)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY="your-firebase-web-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_MESSAGING_SENDER_ID="123456789"
FIREBASE_APP_ID="1:123456789:web:abcdef"
FIREBASE_VAPID_KEY="your-web-push-vapid-key"

# Twilio SMS (optional — texts owner's phone when someone scans QR)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# TURN server for voice calls across different networks (WiFi <-> mobile data).
# Without a real TURN server, cross-network calls stay stuck on "Connecting...".
# Free option: sign up at https://www.metered.ca/tools/openrelay (50GB/mo free) and paste creds.
TURN_URLS=""            # e.g. "turn:a.relay.metered.ca:80,turns:a.relay.metered.ca:443?transport=tcp"
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Google Gemini (optional — AI-enhance photos for artistic QR stickers)
GEMINI_API_KEY=""
# Optional override — defaults try gemini-2.5-flash-image then gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# Session pooler (5432) — use for long-running servers like this API
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Direct connection — use for prisma db push / migrate only (username is usually `postgres`)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
PORT=3001
# Dev: LAN IP for phone testing. Production: your live URL (e.g. https://qrhorn.onrender.com)
CORS_ORIGIN="http://localhost:3000,http://192.168.1.36:3000"
# Production: set NODE_ENV=production on the host (Render sets this automatically)
