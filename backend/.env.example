# Supabase (same project as database)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Firebase Cloud Messaging (for push notifications)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_API_KEY="your-firebase-web-api-key"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_MESSAGING_SENDER_ID="123456789"
FIREBASE_APP_ID="1:123456789:web:abcdef"
FIREBASE_VAPID_KEY="your-web-push-vapid-key"

# SMS alerts (optional — pick ONE provider)
#
# --- Fast2SMS (India) ---
# IMPORTANT: route "q" (Quick SMS) costs ~Rs 5/SMS. Use route "dlt" for ~Rs 0.25/SMS.
# Sign up: https://www.fast2sms.com
FAST2SMS_API_KEY=""
# dlt = cheap (needs DLT template, see DEPLOY.md). q = expensive Quick SMS.
FAST2SMS_ROUTE="dlt"
# From Fast2SMS DLT Manager after template approval (e.g. QRHORN)
FAST2SMS_SENDER_ID=""
# 6-digit Message ID from Fast2SMS DLT Manager (Dev API shows it per template)
FAST2SMS_MESSAGE_ID=""
#
# --- Twilio (global, more expensive) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# TURN server for voice calls across different networks (WiFi <-> mobile data).
# Without a real TURN server, cross-network calls stay stuck on "Connecting...".
#
# RECOMMENDED — Metered dynamic API (server fetches the correct ICE array for your plan):
#   1. Sign up at https://dashboard.metered.ca
#   2. METERED_APP_NAME = your app name shown on the Dashboard home page
#      (the "<appname>" in https://<appname>.metered.live)
#   3. METERED_API_KEY = a credential's apiKey (Dashboard -> TURN Server -> a credential)
METERED_APP_NAME=""
METERED_API_KEY=""
#
# ALTERNATIVE — hand-configured TURN (coturn, or a fixed Metered credential).
# On Metered's FREE plan only standard.relay.metered.ca works.
TURN_URLS=""            # e.g. "turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443?transport=tcp"
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Google Gemini (optional — AI-enhance photos for artistic QR stickers)
GEMINI_API_KEY=""
# Optional override — defaults try gemini-2.5-flash-image then gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"

# Session pooler (5432) — use for long-running servers like this API
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Direct connection — use for prisma db push / migrate only (username is usually `postgres`)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
PORT=3001
# Dev: LAN IP for phone testing. Production: your live URL (e.g. https://qrhorn.onrender.com)
CORS_ORIGIN="http://localhost:3000,http://192.168.1.36:3000"
# Production: set NODE_ENV=production on the host (Render sets this automatically)
